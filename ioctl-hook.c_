/**
 * Hook used for debugging binder transactions.
 * Compilation:
 *  aarch64-linux-gnu-gcc -nostdlib -shared ioctl-hook.c -o ioctl-hook.so
 * Usage:
 *  LD_PRELOAD=$(pwd)/ioctl-hook.so ./your-binary
 */

#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdio.h>
#include <errno.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <linux/android/binder.h>

static int (*real_ioctl)(int, unsigned long, void*) = NULL;

static void dump_hex(const void *buf, size_t len, size_t n_indent) {
    const unsigned char *p = buf;
    for (size_t i = 0; i < len; i++) {
        if (i % 16 == 0) {
            if (i > 0)
                putchar('\n');
            for (uint32_t j = 0; j < n_indent; j++)
                printf("    ");
        }

        printf("%02x ", p[i]);
    }
    putchar('\n');
}

static const char * cmd_to_string(uint32_t cmd)
{
    switch (cmd) {
    case BC_TRANSACTION: return "BC_TRANSACTION";
    case BC_REPLY: return "BC_REPLY";
    case BC_ACQUIRE_RESULT: return "BC_ACQUIRE_RESULT";
    case BC_FREE_BUFFER: return "BC_FREE_BUFFER";
    case BC_INCREFS: return "BC_INCREFS";
    case BC_ACQUIRE: return "BC_ACQUIRE";
    case BC_RELEASE: return "BC_RELEASE";
    case BC_DECREFS: return "BC_DECREFS";
    case BC_INCREFS_DONE: return "BC_INCREFS_DONE";
    case BC_ACQUIRE_DONE: return "BC_ACQUIRE_DONE";
    case BC_ATTEMPT_ACQUIRE: return "BC_ATTEMPT_ACQUIRE";
    case BC_REGISTER_LOOPER: return "BC_REGISTER_LOOPER";
    case BC_ENTER_LOOPER: return "BC_ENTER_LOOPER";
    case BC_EXIT_LOOPER: return "BC_EXIT_LOOPER";
    case BC_REQUEST_DEATH_NOTIFICATION: return "BC_REQUEST_DEATH_NOTIFICATION";
    case BC_CLEAR_DEATH_NOTIFICATION: return "BC_CLEAR_DEATH_NOTIFICATION";
    case BC_DEAD_BINDER_DONE: return "BC_DEAD_BINDER_DONE";
    case BC_TRANSACTION_SG: return "BC_TRANSACTION_SG";
    case BC_REPLY_SG: return "BC_REPLY_SG";
                      /*
    case BC_REQUEST_FREEZE_NOTIFICATION: return "BC_REQUEST_FREEZE_NOTIFICATION";
    case BC_CLEAR_FREEZE_NOTIFICATION: return "BC_CLEAR_FREEZE_NOTIFICATION";
    case BC_FREEZE_NOTIFICATION_DONE: return "BC_FREEZE_NOTIFICATION_DONE";
    */
    case BR_ERROR: return "BR_ERROR";
    case BR_OK: return "BR_OK";
    case BR_TRANSACTION_SEC_CTX: return "BR_TRANSACTION_SEC_CTX";
    case BR_TRANSACTION: return "BR_TRANSACTION";
    case BR_REPLY: return "BR_REPLY";
    case BR_ACQUIRE_RESULT: return "BR_ACQUIRE_RESULT";
    case BR_DEAD_REPLY: return "BR_DEAD_REPLY";
    case BR_TRANSACTION_COMPLETE: return "BR_TRANSACTION_COMPLETE";
    case BR_INCREFS: return "BR_INCREFS";
    case BR_ACQUIRE: return "BR_ACQUIRE";
    case BR_RELEASE: return "BR_RELEASE";
    case BR_DECREFS: return "BR_DECREFS";
    case BR_ATTEMPT_ACQUIRE: return "BR_ATTEMPT_ACQUIRE";
    case BR_NOOP: return "BR_NOOP";
    case BR_SPAWN_LOOPER: return "BR_SPAWN_LOOPER";
    case BR_FINISHED: return "BR_FINISHED";
    case BR_DEAD_BINDER: return "BR_DEAD_BINDER";
    case BR_CLEAR_DEATH_NOTIFICATION_DONE: return "BR_CLEAR_DEATH_NOTIFICATION_DONE";
    case BR_FAILED_REPLY: return "BR_FAILED_REPLY";
    case BR_FROZEN_REPLY: return "BR_FROZEN_REPLY";
    case BR_ONEWAY_SPAM_SUSPECT: return "BR_ONEWAY_SPAM_SUSPECT";
                                 /*
    case BR_TRANSACTION_PENDING_FROZEN: return "BR_TRANSACTION_PENDING_FROZEN";
    case BR_FROZEN_BINDER: return "BR_FROZEN_BINDER";
    case BR_CLEAR_FREEZE_NOTIFICATION_DONE: return "BR_CLEAR_FREEZE_NOTIFICATION_DONE";
    */
    default: return "(unknown)";
    }
}

static const char * ioctl_req_to_string(unsigned long req)
{
    switch (req) {
    case BINDER_WRITE_READ: return "BINDER_WRITE_READ";
    case BINDER_SET_IDLE_TIMEOUT: return "BINDER_SET_IDLE_TIMEOUT";
    case BINDER_SET_MAX_THREADS: return "BINDER_SET_MAX_THREADS";
    case BINDER_SET_IDLE_PRIORITY: return "BINDER_SET_IDLE_PRIORITY";
    case BINDER_SET_CONTEXT_MGR: return "BINDER_SET_CONTEXT_MGR";
    case BINDER_THREAD_EXIT: return "BINDER_THREAD_EXIT";
    case BINDER_VERSION: return "BINDER_VERSION";
    case BINDER_GET_NODE_DEBUG_INFO: return "BINDER_GET_NODE_DEBUG_INFO";
    case BINDER_GET_NODE_INFO_FOR_REF: return "BINDER_GET_NODE_INFO_FOR_REF";
    case BINDER_SET_CONTEXT_MGR_EXT: return "BINDER_SET_CONTEXT_MGR_EXT";
    case BINDER_FREEZE: return "BINDER_FREEZE";
    case BINDER_GET_FROZEN_INFO: return "BINDER_GET_FROZEN_INFO";
    case BINDER_ENABLE_ONEWAY_SPAM_DETECTION: return "BINDER_ENABLE_ONEWAY_SPAM_DETECTION";
    case BINDER_GET_EXTENDED_ERROR: return "BINDER_GET_EXTENDED_ERROR";
    default: return NULL;
    }
}

static const char * binder_obj_type_to_string(uint32_t t)
{
    switch (t) {
    case BINDER_TYPE_BINDER: return "BINDER_TYPE_BINDER";
    case BINDER_TYPE_WEAK_BINDER: return "BINDER_TYPE_WEAK_BINDER";
    case BINDER_TYPE_HANDLE: return "BINDER_TYPE_HANDLE";
    case BINDER_TYPE_WEAK_HANDLE: return "BINDER_TYPE_WEAK_HANDLE";
    case BINDER_TYPE_FD: return "BINDER_TYPE_FD";
    case BINDER_TYPE_FDA: return "BINDER_TYPE_FDA";
    case BINDER_TYPE_PTR: return "BINDER_TYPE_PTR";
    default: return "(unknown)";
    }
}

enum android_status {
    OK                  = 0,
    NO_ERROR            = OK,
    UNKNOWN_ERROR       = (-2147483647-1), // INT32_MIN value
    NO_MEMORY           = -ENOMEM,
    INVALID_OPERATION   = -ENOSYS,
    BAD_VALUE           = -EINVAL,
    BAD_TYPE            = (UNKNOWN_ERROR + 1),
    NAME_NOT_FOUND      = -ENOENT,
    PERMISSION_DENIED   = -EPERM,
    NO_INIT             = -ENODEV,
    ALREADY_EXISTS      = -EEXIST,
    DEAD_OBJECT         = -EPIPE,
    FAILED_TRANSACTION  = (UNKNOWN_ERROR + 2),
    BAD_INDEX           = -EOVERFLOW,
    NOT_ENOUGH_DATA     = -ENODATA,
    WOULD_BLOCK         = -EWOULDBLOCK,
    TIMED_OUT           = -ETIMEDOUT,
    UNKNOWN_TRANSACTION = -EBADMSG,
    FDS_NOT_ALLOWED     = (UNKNOWN_ERROR + 7),
    UNEXPECTED_NULL     = (UNKNOWN_ERROR + 8),
};

static const char * android_status_to_string(int32_t s)
{
    switch (s) {
    case OK: return "OK";
    case UNKNOWN_ERROR: return "UNKNOWN_ERROR";
    case NO_MEMORY: return "NO_MEMORY";
    case INVALID_OPERATION: return "INVALID_OPERATION";
    case BAD_VALUE: return "BAD_VALUE";
    case BAD_TYPE: return "BAD_TYPE";
    case NAME_NOT_FOUND: return "NAME_NOT_FOUND";
    case PERMISSION_DENIED: return "PERMISSION_DENIED";
    case NO_INIT: return "NO_INIT";
    case ALREADY_EXISTS: return "ALREADY_EXISTS";
    case DEAD_OBJECT: return "DEAD_OBJECT";
    case FAILED_TRANSACTION: return "FAILED_TRANSACTION";
    case BAD_INDEX: return "BAD_INDEX";
    case NOT_ENOUGH_DATA: return "NOT_ENOUGH_DATA";
    case WOULD_BLOCK: return "WOULD_BLOCK";
    case TIMED_OUT: return "TIMED_OUT";
    case UNKNOWN_TRANSACTION: return "UNKNOWN_TRANSACTION";
    case FDS_NOT_ALLOWED: return "FDS_NOT_ALLOWED";
    case UNEXPECTED_NULL: return "UNEXPECTED_NULL";
    default: return "(unknown)";
    }
}

static const uint32_t TRANSACTION_FLAGS[] = {
    TF_ONE_WAY, TF_ROOT_OBJECT, TF_STATUS_CODE,
    TF_ACCEPT_FDS, TF_CLEAR_BUF, TF_UPDATE_TXN
};
static const size_t N_TRANSACTION_FLAGS = sizeof(TRANSACTION_FLAGS) / sizeof(uint32_t);
static const char * transaction_flag_to_string(uint32_t f)
{
    switch (f) {
    case TF_ONE_WAY: return "TF_ONE_WAY";
    case TF_ROOT_OBJECT: return "TF_ROOT_OBJECT";
    case TF_STATUS_CODE: return "TF_STATUS_CODE";
    case TF_ACCEPT_FDS: return "TF_ACCEPT_FDS";
    case TF_CLEAR_BUF: return "TF_CLEAR_BUF";
    case TF_UPDATE_TXN: return "TF_UPDATE_TXN";
    default: return "<unknown>";
    }
}

static const uint32_t FLAT_BINDER_FLAGS[] = {
	FLAT_BINDER_FLAG_PRIORITY_MASK,
	FLAT_BINDER_FLAG_ACCEPTS_FDS,
	FLAT_BINDER_FLAG_TXN_SECURITY_CTX,
};
static const size_t N_FLAT_BINDER_FLAGS = sizeof(FLAT_BINDER_FLAGS) / sizeof(uint32_t);

static const char * flat_binder_flag_to_string(uint32_t f)
{
    switch (f) {
	case FLAT_BINDER_FLAG_PRIORITY_MASK: return "FLAT_BINDER_FLAG_PRIORITY_MASK";
	case FLAT_BINDER_FLAG_ACCEPTS_FDS: return "FLAT_BINDER_FLAG_ACCEPTS_FDS";
	case FLAT_BINDER_FLAG_TXN_SECURITY_CTX: return "FLAT_BINDER_FLAG_TXN_SECURITY_CTX";
    default: return "<unknown>";
    }
}

static const uint32_t BINDER_BUFFER_FLAGS[] = {
    BINDER_BUFFER_FLAG_HAS_PARENT
};
static const size_t N_BINDER_BUFFER_FLAGS = sizeof(BINDER_BUFFER_FLAGS) / sizeof(uint32_t);

static const char * binder_buffer_flag_to_string(uint32_t f)
{
    switch (f) {
    case BINDER_BUFFER_FLAG_HAS_PARENT: return "BINDER_BUFFER_FLAG_HAS_PARENT";
    default: return "<unknown>";
    }
}

typedef const char * (*flag_tostring_proc_t)(uint32_t);

static void dump_flags(uint32_t v, const uint32_t *flags, size_t n_flags,
        const char *prefix, flag_tostring_proc_t to_string_proc)
{
    if (v == 0) {
        printf("%s0x0\n", prefix);
        return;
    }

    int found_anything = 0;
    for (uint32_t i = 0; i < n_flags; i++) {
        if (!(v & flags[i]))
            continue;
        if (!found_anything) {
            found_anything = 1;
            printf("%s0x%x (", prefix, v);
        } else {
            printf(" | ");
        }

        printf("%s", to_string_proc(flags[i]));
    }
    if (!found_anything) {
        printf("%s0x%x\n", prefix, v);
        return;
    } else {
        printf(")\n");
        return;
    }
}

static void dump_binder_transaction_data(struct binder_transaction_data *tr)
{
    printf("        target.handle: %u\n", tr->target.handle);
    printf("        cookie: 0x%llx\n", tr->cookie);
    printf("        code: %u\n", tr->code);
    dump_flags(tr->flags, TRANSACTION_FLAGS, N_TRANSACTION_FLAGS,
            "        flags: ", transaction_flag_to_string);
    printf("        sender_pid: %d\n", tr->sender_pid);
    printf("        sender_euid: %u\n", tr->sender_euid);
    printf("        data_size: %zu\n", (size_t)tr->data_size);
    printf("        data_buffer: 0x%llx\n", tr->data.ptr.buffer);
    dump_hex((void *)tr->data.ptr.buffer, tr->data_size, 3);
    if (tr->flags & TF_STATUS_CODE) {
        if (tr->data_size < sizeof(int32_t)) {
            fprintf(stderr, "%s: data_size too small for a status code!\n",
                    __func__);
            fflush(stderr);
            abort();
        }
        int32_t status = 0;
        memcpy(&status, (void *)tr->data.ptr.buffer, sizeof(status));
        printf("            -> status: %d (%s)\n",
                status, android_status_to_string(status));
    }
    printf("        offsets_size: %zu\n", (size_t)tr->offsets_size);
    printf("        offsets_buffer: 0x%llx\n", tr->data.ptr.offsets);
    for (uint32_t i = 0; i < tr->offsets_size; i += sizeof(binder_size_t)) {
        binder_size_t o;
        memcpy(&o, (uint8_t *)tr->data.ptr.offsets + i, sizeof(binder_size_t));
        printf("            [%lu] %zu\n", (long unsigned)i / sizeof(binder_size_t), (size_t)o);

        uint32_t type = 0;
        memcpy(&type, (uint8_t *)tr->data.ptr.buffer + o, sizeof(uint32_t));
        printf("                -> hdr.type: %u - %s\n", type, binder_obj_type_to_string(type));
        switch (type) {
        case BINDER_TYPE_BINDER:
        case BINDER_TYPE_HANDLE:
        case BINDER_TYPE_WEAK_BINDER:
        case BINDER_TYPE_WEAK_HANDLE: {
            struct flat_binder_object b;
            memcpy(&b, (uint8_t *)tr->data.ptr.buffer + o, sizeof(b));

            dump_flags(b.flags, FLAT_BINDER_FLAGS, N_FLAT_BINDER_FLAGS,
                    "                -> flags: ", flat_binder_flag_to_string);
            printf("                -> handle: %u\n", b.handle);
            printf("                -> cookie: 0x%llx\n", b.cookie);
            break;
        }
        case BINDER_TYPE_FD: {
            struct binder_fd_object fd;
            memcpy(&fd, (uint8_t *)tr->data.ptr.buffer + o, sizeof(fd));

            printf("                -> fd: %d\n", fd.fd);
            printf("                -> cookie: 0x%llx\n", fd.cookie);
            break;
        }
        case BINDER_TYPE_FDA: {
            struct binder_fd_array_object fda;
            memcpy(&fda, (uint8_t *)tr->data.ptr.buffer + o, sizeof(fda));

            printf("                -> num_fds: %zu\n", (size_t)fda.num_fds);
            printf("                -> parent: %zu\n", (size_t)fda.parent);
            printf("                -> parent_offset: %zu\n", (size_t)fda.parent_offset);
            break;
        }
        case BINDER_TYPE_PTR: {
            struct binder_buffer_object ptr;
            memcpy(&ptr, (uint8_t *)tr->data.ptr.buffer + o, sizeof(ptr));

            dump_flags(ptr.flags, BINDER_BUFFER_FLAGS, N_BINDER_BUFFER_FLAGS,
                    "                -> flags: ", binder_buffer_flag_to_string);
            printf("                -> length: %zu\n", (size_t)ptr.length);
            printf("                -> buffer: 0x%llx\n", ptr.buffer);
            dump_hex((void *)ptr.buffer, ptr.length, 5);
            printf("                -> parent: %zu\n", (size_t)ptr.parent);
            printf("                -> parent_offset: %zu\n", (size_t)ptr.parent_offset);
            break;
        }
        default:
            printf("            unknown binder object type %u (0x%x)!\n", type, type);
            return;
        }
    }
}

int ioctl(int fd, unsigned long req, void *arg)
{
    if (!real_ioctl)
        real_ioctl = dlsym(RTLD_NEXT, "ioctl");

    const char *name = ioctl_req_to_string(req);
    if (name)
        printf("\n***** detected binder ioctl req: %lu (%s) *****\n", req, name);
    if (!name || req != BINDER_WRITE_READ)
        return real_ioctl(fd, req, arg);

    printf("===== BEGIN BINDER_WRITE_READ ioctl dump =====\n");
    struct binder_write_read *bwr = arg;
    printf("write_size=%llu write_consumed=%llu\n",
           bwr->write_size, bwr->write_consumed);
    if (bwr->write_size < sizeof(uint32_t))
        goto skip_write_buf;

    printf(">>>>> BEGIN write_buffer\n");

    printf("    write_buffer hexdump:\n");
    dump_hex((void*)bwr->write_buffer, bwr->write_size, 2);

    uint8_t *p = (void *)bwr->write_buffer;
    uint8_t *end = p + bwr->write_size;
    uint32_t cmd = 0;

    while (p < end) {
        memcpy(&cmd, p, sizeof(uint32_t));
        p += sizeof(uint32_t);
        printf("    cmd: %u (%s)\n", cmd, cmd_to_string(cmd));
        switch ((enum binder_driver_command_protocol)cmd) {
            case BC_ACQUIRE:
            case BC_INCREFS:
            case BC_DECREFS:
            case BC_RELEASE: {
                uint32_t handle = 0;
                memcpy(&handle, p, sizeof(handle));
                p += sizeof(handle);
                printf("        handle: %u\n", handle);
                break;
            }
            case BC_ENTER_LOOPER:
            case BC_EXIT_LOOPER:
                break;
            case BC_TRANSACTION_SG: {
                struct binder_transaction_data_sg tr_sg;
                memcpy(&tr_sg, p, sizeof(tr_sg));
                p += sizeof(tr_sg);
                dump_binder_transaction_data(&tr_sg.transaction_data);
                printf("        sg buffers size: %zu\n", (size_t)tr_sg.buffers_size);
                break;
            }
            case BC_TRANSACTION: {
                struct binder_transaction_data tr;
                memcpy(&tr, p, sizeof(tr));
                p += sizeof(tr);
                dump_binder_transaction_data(&tr);
                break;
            }
            case BC_FREE_BUFFER: {
                binder_uintptr_t ptr = 0;
                memcpy(&ptr, p, sizeof(ptr));
                p += sizeof(ptr);
                printf("        BC_FREE_BUFFER ptr: 0x%016llx\n", ptr);
                break;
            }
            default:
                printf("        unsupported cmd %u; skip read\n", cmd);
                p = end;
                break;
        }
    }
    printf("<<<<< END write_buffer\n");

skip_write_buf:

    printf("(before ioctl) read_size=%llu read_consumed=%llu\n",
           bwr->read_size, bwr->read_consumed);
    int ret = real_ioctl(fd, req, arg);
    printf("ret = %d\n", ret);
    printf("(after ioctl) read_size=%llu read_consumed=%llu\n",
           bwr->read_size, bwr->read_consumed);

    if (bwr->read_size < sizeof(uint32_t)) {
        printf("read_size too small; skip read buffer\n");
        goto skip_read_buf;
    }

    printf(">>>>> BEGIN read_buffer\n");

    printf("    read_buffer hexdump:\n");
    dump_hex((void*)bwr->read_buffer, bwr->read_consumed, 2);

    p = (void *)bwr->read_buffer;
    end = p + bwr->read_consumed;
    while (p < end) {
        memcpy(&cmd, p, sizeof(uint32_t));
        p += sizeof(uint32_t);
        printf("    cmd: %u (%s)\n", cmd, cmd_to_string(cmd));

        switch ((enum binder_driver_return_protocol)cmd) {
            case BR_ERROR: {
                int32_t error_code = 0;
                memcpy(&error_code, p + sizeof(cmd),
                        sizeof(int32_t));
                p += sizeof(int32_t);
                printf("        Error code: %d\n", error_code);
                break;
            }
            case BR_TRANSACTION_COMPLETE:
            case BR_OK:
            case BR_NOOP:
                break;
            case BR_TRANSACTION:
            case BR_REPLY: {
                struct binder_transaction_data tr;
                memcpy(&tr, p, sizeof(tr));
                p += sizeof(tr);
                dump_binder_transaction_data(&tr);
                break;
            }
            default:
                printf("unsupported cmd %u; skip read\n", cmd);
                goto skip_read_buf;
        }
    }

skip_read_buf:
    printf("=====  END BINDER_WRITE_READ ioctl dump  =====\n\n");
    return ret;
}
